{
  "name": "obsidian-pi-chat",
  "version": "1.0.0",
  "description": "Chat with your local Pi coding agent inside Obsidian. Zero-config thin shell over your real `pi` binary — no bundled runtime, no API keys, no plugin-side model config.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:fast": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-test.mjs",
    "copy": "node scripts/copy-to-vault.mjs",
    "check": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian", "plugin", "pi", "ai", "coding-agent"],
  "author": "Larry Song",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/songlining/obsidian-pi-chat.git"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {}
}
